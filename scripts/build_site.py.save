    parts = []

    parts.append("<!doctype html>")
    parts.append('<html lang="ru">')
    parts.append("<head>")
    parts.append('<meta charset="utf-8">')
    parts.append('<meta name="viewport" content="width=device-width, initial-scale=1">')
    parts.append('<meta name="color-scheme" content="light">')
    parts.append("<title>мтДНК × Психиатрия — Demo Dashboard</title>")
    parts.append("<style>")
    parts.append(css)
    parts.append("</style>")
    parts.append("</head>")
    parts.append("<body>")

    # Hero
    parts.append('<header class="hero">')
    parts.append('<div class="hero-inner">')
    parts.append('<div class="eyebrow">mtDNA · Psychiatry · Research demo</div>')
    parts.append("<h1>Дашборд предварительного анализа мтДНК</h1>")
    parts.append(
        "<p>Статический sanitized-дашборд, собранный локально из "
        "<code>snps.annotations.txt</code>, <code>samples.qc.txt</code> и "
