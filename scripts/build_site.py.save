  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.hero h1 {
  margin: 0 0 10px;
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.08;
  letter-spacing: -0.03em;
}

.hero p {
  margin: 0;
  max-width: 980px;
  color: rgba(255, 255, 255, 0.88);
  font-size: 15px;
}

